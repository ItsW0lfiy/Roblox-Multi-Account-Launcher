<Window x:Class="RobloxMultiAccountLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:RobloxMultiAccountLauncher.Models"
        Title="Roblox Multi-Account Launcher" Width="1040" Height="720" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Roblox Multi-Account Launcher" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="External launcher, client manager, and optional multi-account protection" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12,6" VerticalAlignment="Center">
                <TextBlock x:Name="ModeBadge" Text="NORMAL MODE" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
            </Border>
        </Grid>

        <TabControl Grid.Row="1" x:Name="MainTabs">
            <TabItem Header="Home">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,14,0">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Launch Roblox" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="BackendSummary" Text="Auto detection in progress…" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,6,0,16"/>
                                    <WrapPanel>
                                        <Button x:Name="LaunchButton" Content="Launch Roblox" Style="{StaticResource PrimaryButton}" Click="LaunchButton_Click" Margin="0,0,10,0"/>
                                        <Button x:Name="LaunchAnotherButton" Content="Launch Another Client" Click="LaunchButton_Click" IsEnabled="False"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="LaunchProgressText" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,14,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock Text="Multi-Account Mode" FontSize="18" FontWeight="SemiBold"/>
                                            <TextBlock Text="Always starts OFF. Enabling may require closing Roblox." Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="MultiToggle" DockPanel.Dock="Right" Content="" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="Multi-instance" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock x:Name="MutexStateText" Text="Disabled" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="Teleport protection" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock x:Name="CookieStateText" Text="Disabled" FontWeight="SemiBold" Margin="0,4,0,0" ToolTip="Holds RobloxCookies.dat read-only and exclusively without reading its contents."/></StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Roblox Clients" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ClientCountText" Text="0 running" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,8"/>
                                    <Button Content="Open Client Manager" Click="OpenClients_Click" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <DockPanel><TextBlock Text="Recent Activity" FontSize="16" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" Content="Refresh" Padding="10,5" MinHeight="28" Click="RefreshButton_Click"/></DockPanel>
                                    <ItemsControl x:Name="ActivityList" Margin="0,12,0,0">
                                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,3" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Clients">
                <Grid Margin="0,16,0,8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,12">
                        <Button Content="Tile Clients" Click="TileClients_Click" Margin="0,0,8,0"/>
                        <Button Content="Swap Clients" Click="SwapClients_Click" Margin="0,0,8,0"/>
                        <Button Content="Move Client 1 to Preferred Monitor" Click="MoveClient1_Click" Margin="0,0,8,0"/>
                        <Button Content="Move Client 2 to Preferred Monitor" Click="MoveClient2_Click" Margin="0,0,8,0"/>
                        <Button Content="Close Roblox" Click="CloseAll_Click"/>
                    </WrapPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ClientsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:RobloxClientInfo}">
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="{Binding Number, StringFormat=Client {0}}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding ProcessId, StringFormat=PID {0}}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0"/></StackPanel>
                                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding WindowTitle}" TextTrimming="CharacterEllipsis"/><TextBlock Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,0"><Run Text="Uptime "/><Run Text="{Binding UptimeText}"/><Run Text="  •  RAM "/><Run Text="{Binding MemoryText}"/></TextBlock></StackPanel>
                                            <WrapPanel Grid.Column="2"><Button Content="Focus" Tag="{Binding}" Click="FocusClient_Click" Margin="0,0,8,0"/><Button Content="Close" Tag="{Binding}" Click="CloseClient_Click" Margin="0,0,8,0"/><Button Content="Force Close" Tag="{Binding}" Click="ForceClient_Click"/></WrapPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Diagnostics">
                <Grid Margin="0,16,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="DiagnosticsText" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <Button Content="Refresh Detection" Click="RefreshButton_Click" Margin="0,0,0,8"/>
                        <Button Content="Copy Diagnostics" Click="CopyDiagnostics_Click" Margin="0,0,0,8"/>
                        <Button Content="Open Roblox Logs" Click="OpenRobloxLogs_Click" Margin="0,0,0,8"/>
                        <Button Content="Analyze Recent Roblox Log" Click="AnalyzeRobloxLogs_Click" Margin="0,0,0,8"/>
                        <Button Content="Open Fishstrap" Click="OpenFishstrap_Click" Margin="0,0,0,8"/>
                        <Button Content="Open Fishstrap Folder" Click="OpenFishstrapFolder_Click" Margin="0,0,0,8"/>
                        <Button Content="Open Fishstrap Logs" Click="OpenFishstrapLogs_Click" Margin="0,0,0,8"/>
                        <Button Content="Open Bloxstrap" Click="OpenBloxstrap_Click" Margin="0,0,0,8"/>
                        <Button Content="Repair Launch State" Style="{StaticResource PrimaryButton}" Click="RepairButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,0,8">
                    <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Launch Backend" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="Auto prefers Fishstrap, then Bloxstrap, then stock Roblox." Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,10"/>
                                <ComboBox x:Name="BackendCombo" SelectionChanged="SettingsChanged"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Window Layout" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="Two-client tiling respects the selected monitor work area and taskbar." Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,10"/>
                                <ComboBox x:Name="LayoutCombo" SelectionChanged="SettingsChanged" Margin="0,0,0,10"/>
                                <ComboBox x:Name="MonitorCombo" SelectionChanged="SettingsChanged"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Behavior" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <CheckBox x:Name="MinimizeTrayCheck" Content="Minimize to notification area" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                                <CheckBox x:Name="HotkeysCheck" Content="Enable Ctrl+Alt+1 / Ctrl+Alt+2 focus hotkeys" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                                <CheckBox x:Name="AutoDisableCheck" Content="Automatically disable multi-account mode 30 seconds after all clients close" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0"><TextBlock Text="Launch timeout (seconds)"/><TextBox x:Name="LaunchTimeoutText" Margin="0,7,0,0" LostFocus="SettingsChanged"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="Graceful close timeout (seconds)"/><TextBox x:Name="CloseTimeoutText" Margin="0,7,0,0" LostFocus="SettingsChanged"/></StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
            <DockPanel><TextBlock x:Name="StateText" Text="Normal" FontWeight="SemiBold"/><TextBlock x:Name="FooterText" DockPanel.Dock="Right" Foreground="{StaticResource SecondaryTextBrush}" Text="Local only • No telemetry"/></DockPanel>
        </Border>
    </Grid>
</Window>
